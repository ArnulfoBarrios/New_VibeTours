{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/legal", "destination": "/landing/legal.html" },
    { "source": "/register", "destination": "/landing/register.html" },
    { "source": "/assets/(.*)", "destination": "/landing/assets/$1" },
    { "source": "/styles.css", "destination": "/landing/styles.css" },
    { "source": "/app.js", "destination": "/landing/app.js" }
  ]
}
